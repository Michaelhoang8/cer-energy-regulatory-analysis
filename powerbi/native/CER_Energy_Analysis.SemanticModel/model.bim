        "partitions": [
          {
            "name": "FactFlow",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                " Nullable = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, {\"ObservedDays\", \"ExpectedDays\", \"PairedDays\", \"ThroughputSum\", \"CapacitySum\", \"ThroughputDays\", \"CapacityDays\", \"ThroughputAllSum\", \"CapacityAllSum\", \"MissingCapacityDays\", \"MissingThroughputDays\", \"OverCapacityDays\", \"NegativeThroughputDays\"}),",
                " Typed = Table.TransformColumnTypes(Nullable, {{\"Month\", type text}, {\"PointId\", type text}, {\"ObservedDays\", Int64.Type}, {\"ExpectedDays\", Int64.Type}, {\"PairedDays\", Int64.Type}, {\"ThroughputSum\", type number}, {\"CapacitySum\", type number}, {\"ThroughputDays\", Int64.Type}, {\"CapacityDays\", Int64.Type}, {\"ThroughputAllSum\", type number}, {\"CapacityAllSum\", type number}, {\"MissingCapacityDays\", Int64.Type}, {\"MissingThroughputDays\", Int64.Type}, {\"OverCapacityDays\", Int64.Type}, {\"NegativeThroughputDays\", Int64.Type}}, \"en-US\")",
                "in",
                " Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Observed point-days",
            "expression": "SUM(FactFlow[ObservedDays])",
            "formatString": "#,0",
            "description": "Reported daily observations, counted separately at each key point.",
            "lineageTag": "b008d7eb-f1f0-5bc0-8249-fde5a1614ad5"
          },
          {
            "name": "Expected point-days",
            "expression": "SUM(FactFlow[ExpectedDays])",
            "formatString": "#,0",
            "description": "Expected daily observations under the documented active-series coverage policy.",
            "lineageTag": "7fe7da70-dca6-555f-9784-c3fd24ecb8b4"
          },
          {
            "name": "Paired point-days",
            "expression": "SUM(FactFlow[PairedDays])",
            "formatString": "#,0",
            "description": "Days with usable paired volumetric throughput and positive capacity.",
            "lineageTag": "d233d0ed-1f2e-5515-95f2-385bd0cebc49"
          },
          {
            "name": "Mean throughput",
            "expression": "IF(HASONEVALUE(DimPoint[PointId]), DIVIDE(SUM(FactFlow[ThroughputAllSum]), SUM(FactFlow[ThroughputDays])))",
            "formatString": "#,0.0",
            "description": "Mean valid daily throughput at one selected point; thousand cubic metres per day.",
            "lineageTag": "1245a6ef-93f4-544c-b785-6e87dc9dd22d"
          },
          {
            "name": "Mean capacity",
            "expression": "IF(HASONEVALUE(DimPoint[PointId]), DIVIDE(SUM(FactFlow[CapacityAllSum]), SUM(FactFlow[CapacityDays])))",
            "formatString": "#,0.0",
            "description": "Mean valid reported capacity at one selected point; thousand cubic metres per day.",
            "lineageTag": "3765bb0e-3613-505a-8e68-1b029b8845e2"
          },
          {
            "name": "Utilization",
            "expression": "IF(HASONEVALUE(DimPoint[PointId]), DIVIDE(SUM(FactFlow[ThroughputSum]), SUM(FactFlow[CapacitySum])))",
            "formatString": "0.0%",
            "description": "Paired throughput divided by paired reported capacity at one point. This is a ratio of sums, not an average of monthly ratios.",
            "lineageTag": "d3c8af4b-9437-5859-b622-dec22d279280"
          },
          {
            "name": "Reporting coverage",
            "expression": "DIVIDE([Observed point-days], [Expected point-days])",
            "formatString": "0.00%",
            "description": "Observed point-days divided by expected point-days. Does not imply field completeness.",
            "lineageTag": "62fd11f5-aa64-5e7f-bee0-c64f07663e39"
          },
          {
            "name": "Missing capacity days",
            "expression": "SUM(FactFlow[MissingCapacityDays])",
            "formatString": "#,0",
            "description": "Observed point-days whose capacity is missing or unusable under pipeline validation.",
            "lineageTag": "2b151952-aa98-50e9-87b1-290b85e5bad0"
          },
          {
            "name": "Missing throughput days",
            "expression": "SUM(FactFlow[MissingThroughputDays])",
            "formatString": "#,0",
            "description": "Observed point-days whose throughput is missing or unusable under pipeline validation.",
            "lineageTag": "8914a7d2-5c57-563e-96fa-125810a4ff0f"
          },
          {
            "name": "Above reported capacity",
            "expression": "SUM(FactFlow[OverCapacityDays])",
            "formatString": "#,0",
            "description": "Point-days above the published capacity estimate; not a finding of noncompliance.",
            "lineageTag": "7575425d-9696-5d2c-9684-338eef1b7cd4"
          },
          {
            "name": "Negative throughput days",
            "expression": "SUM(FactFlow[NegativeThroughputDays])",
            "formatString": "#,0",
            "description": "Negative volumetric observations retained as review flags.",
            "lineageTag": "e7e16841-94e9-5762-896d-c38a5176efe8"
          }
        ]
      },
