        "partitions": [
          {
            "name": "FactIncident",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                " Nullable = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, {\"Year\", \"Latitude\", \"Longitude\", \"ClosureDays\"}),",
                " Typed = Table.TransformColumnTypes(Nullable, {{\"IncidentId\", type text}, {\"Month\", type text}, {\"Year\", Int64.Type}, {\"Province\", type text}, {\"Company\", type text}, {\"Status\", type text}, {\"Significant\", type text}, {\"Types\", type text}, {\"SpatialStatus\", type text}, {\"Latitude\", type number}, {\"Longitude\", type number}, {\"ClosureDays\", type number}}, \"en-US\")",
                "in",
                " Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Incidents",
            "expression": "COUNTROWS(FactIncident)",
            "formatString": "#,0",
            "description": "Unique incident records in the comprehensive CER extract, grouped by reported month.",
            "lineageTag": "8d9c34f0-912a-5619-ba7f-081da5f63572"
          },
          {
            "name": "Open incidents",
            "expression": "COALESCE(CALCULATE(COUNTROWS(FactIncident), KEEPFILTERS(FactIncident[Status] IN {\"Initially Submitted\", \"Submitted\"})), 0)",
            "formatString": "#,0",
            "description": "Incidents with preliminary or submitted review status at snapshot time.",
            "lineageTag": "283602a0-3aaa-53e1-8aac-65f044190d03"
          },
          {
            "name": "Significant incidents",
            "expression": "COALESCE(CALCULATE(COUNTROWS(FactIncident), KEEPFILTERS(FactIncident[Significant] = \"Yes\")), 0)",
            "formatString": "#,0",
            "description": "Incidents explicitly classified Significant=Yes by the source.",
            "lineageTag": "6a25ec02-eee6-5d8b-9f97-6328c3a3f315"
          },
          {
            "name": "Located incidents",
            "expression": "COALESCE(COUNTROWS(FILTER(FactIncident, NOT(ISBLANK(FactIncident[Latitude])) && NOT(ISBLANK(FactIncident[Longitude])))), 0)",
            "formatString": "#,0",
            "description": "Incident records with usable latitude and longitude; does not establish an exact pipeline match.",
            "lineageTag": "6b68735a-1251-5008-bc80-fa3b96126b2c"
          }
        ]
      }
    ],
